# --- Google Gemini (free tier — get key at https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
MAIN_MODEL=gemini/gemini-2.5-flash           # CrewAI/LiteLLM format
ROUTER_MODEL=gemini/gemini-2.5-flash-lite    # cheap model for Week 7 tiering
EMBED_MODEL=models/text-embedding-004         # 768-dim, free
EMBED_DIM=768

# --- pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=multi_agent_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/multi_agent_system

# --- Observability (Week 6, optional) ---
# Free at langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App config ---
LOG_LEVEL=INFO
CORS_ORIGINS=*
# Set to enable Postgres-backed LangGraph checkpoints (resumable runs):
# CHECKPOINT_DB=postgresql://postgres:postgres@localhost:5432/multi_agent_system

# --- Optional fallback providers ---
# Switch MAIN_MODEL=anthropic/claude-haiku-4-5 (or openai/gpt-4o-mini, groq/llama-3.1-70b)
# and uncomment the matching key below.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- Reranker (optional, used by src/rag/retriever.py when rerank=True) ---
# Free tier at https://dashboard.cohere.com — 1000 calls/month.
COHERE_API_KEY=

# --- Optional: fully local via Ollama (see docs/APPENDIX-OLLAMA.md) ---
# Comment out GOOGLE_API_KEY and uncomment these:
# OLLAMA_BASE_URL=http://localhost:11434
# MAIN_MODEL=ollama/llama3.1:8b
# ROUTER_MODEL=ollama/qwen2.5:3b
# EMBED_MODEL=nomic-embed-text
